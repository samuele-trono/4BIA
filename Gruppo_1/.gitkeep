using System;
using System.Windows.Forms;
using System.Drawing;

namespace acchiappa_la_talpa
{
    public partial class Form1 : Form //Definisce la classe principale che rappresenta la finestra; "partial" significa che il codice è diviso in più file (ad esempio, il designer)
    {
        // Array contenente le 9 posizioni fisse in cui il bottone (la "talpa") può apparire.
        private Point[] positions;
        private Random rnd = new Random(); // Oggetto per generare numeri casuali

        public Form1() //Costruttore
        {
            InitializeComponent();
            InitializePositions(); // Inizializza le posizioni fisse.
        }

        // Inizializza l'array delle posizioni per la griglia 3x3.
        private void InitializePositions()
        {
            positions = new Point[9]; //// Array che contiene le 9 posizioni fisse per il bottone

            // Queste coordinate sono state scelte per avere dei punti simmetrici e centrati nella finestra Form1
            positions[0] = new Point(210, 50);   // In alto a sinistra
            positions[1] = new Point(310, 50);   // In alto al centro
            positions[2] = new Point(410, 50);   // In alto a destra
            positions[3] = new Point(210, 150);  // Centro sinistra
            positions[4] = new Point(310, 150);  // Centro
            positions[5] = new Point(410, 150);  // Centro destra
            positions[6] = new Point(210, 250);  // In basso a sinistra
            positions[7] = new Point(310, 250);  // In basso al centro
            positions[8] = new Point(410, 250);  // In basso a destra
        }
        private void Form1_Load(object sender, EventArgs e) { }

        // Evento eseguito al click della PictureBox1 (la "talpa")
        private void pictureBox1_Click(object sender, EventArgs e)
        {
            int index = rnd.Next(positions.Length);  // Seleziona in modo casuale uno degli indici dell'array (0-8)
            pictureBox1.Location = positions[index];    // Sposta il bottone alla posizione corrispondente nell'array

        }
    }
}
